  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "author": "StarflowDream",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarflowDream/dsh-tier-boost.git"
  },
  "homepage": "https://github.com/StarflowDream/dsh-tier-boost#readme",
  "bugs": {
    "url": "https://github.com/StarflowDream/dsh-tier-boost/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
